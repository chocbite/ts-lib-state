{
  "name": "@chocbite/ts-lib-state",
  "version": "1.3.0",
  "description": "State management library for TypeScript",
  "author": "chocolateandmilkwin",
  "license": "MIT",
  "type": "module",
  "private": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --port 9951",
    "build": "tsup src/index.ts --format esm --dts",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "upgrades": "npx npm-check-updates --target semver",
    "upgrade": "npx npm-check-updates --target semver -u && npm install"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.2",
    "eslint": "^10.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "@chocbite/ts-lib-common": "^1.2.2",
    "@chocbite/ts-supplement-eslint": "^1.0.0"
  },
  "dependencies": {
    "@chocbite/ts-lib-math": "^1.0.0",
    "@chocbite/ts-lib-result": "^1.3.0",
    "@chocbite/ts-lib-svg": "^1.0.1"
  }
}
