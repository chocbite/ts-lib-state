{
  "name": "@chocbite/ts-lib-state",
  "version": "2.4.6",
  "description": "State management library for TypeScript",
  "author": "chocolateandmilkwin",
  "license": "MIT",
  "type": "module",
  "private": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --port 9951",
    "build": "tsdown src/index.ts",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-deps": "npx depcheck",
    "check-trials": "tsc --noEmit",
    "prepublishOnly": "npm run check-deps && npm run check-trials && npm run build",
    "upgrades": "npx npm-check-updates --target semver",
    "upgrade": "npx npm-check-updates --target semver -u && npm install"
  },
  "devDependencies": {
    "@chocbite/ts-supplement-eslint": "^1.0.4",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.12.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@chocbite/ts-lib-common": "^1.7.3",
    "@chocbite/ts-lib-math": "^1.1.3",
    "@chocbite/ts-lib-result": "^1.4.1",
    "@chocbite/ts-lib-svg": "^1.2.0"
  }
}
